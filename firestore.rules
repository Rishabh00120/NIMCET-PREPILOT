rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User-scoped data: Each user can only read and write their own documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollections under /users/{userId}
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId);
      }

      match /slots/{slotId} {
        allow read, write: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /pyq/{entryId} {
        allow read, write: if isOwner(userId);
      }

      match /mocks/{mockId} {
        allow read, write: if isOwner(userId);
      }

      match /errors/{errorId} {
        allow read, write: if isOwner(userId);
      }

      match /revisions/{revisionId} {
        allow read, write: if isOwner(userId);
      }

      match /roadmap/{monthKey} {
        allow read, write: if isOwner(userId);
      }

      match /pyq_papers/{year} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Push subscription metadata for server dispatch
    match /user_push_subscriptions/{userId} {
      allow read, write: if isOwner(userId);

      // Multi-device registration: each user manages their own device tokens
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Server delivery audit history: user can read their logs, only backend Admin SDK can write
      match /delivery_history/{deliveryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // System-wide status for verified backend deployment health (Server Admin SDK writes only)
    match /system_status/{statusId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Deny all other unspecified paths by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
